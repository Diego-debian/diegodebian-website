---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<article class="service-card" data-reveal>
  <span class="service-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" focusable="false">
      {number === '01' && <path d="M5 7h22v18H5zM5 12h22M10 9.5h.01M14 9.5h.01M9 18h14M9 22h9" />}
      {number === '02' && <path d="M10 4h12a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM13 8h6M14 24h4" />}
      {number === '03' && <path d="M6 10h12M14 6l4 4-4 4M26 22H14M18 18l-4 4 4 4" />}
      {number === '04' && <path d="m16 4 2.4 7.6L26 14l-7.6 2.4L16 24l-2.4-7.6L6 14l7.6-2.4L16 4ZM25 24l.7 2.3L28 27l-2.3.7L25 30l-.7-2.3L22 27l2.3-.7L25 24Z" />}
      {number === '05' && <path d="M7 7h6v6H7zM19 19h6v6h-6zM13 10h6M22 19v-6h-9" />}
      {number === '06' && <path d="m20 5 7 7-4 4-7-7a6 6 0 0 1-7.5 7.5L5 21l6 6 4.5-3.5A6 6 0 0 1 23 16" />}
    </svg>
  </span>
  <span class="card-number">{number}</span>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
